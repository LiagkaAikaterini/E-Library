<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.ColorAdjust?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <content>
      <AnchorPane prefHeight="333.0" prefWidth="421.0" style="-fx-background-color: #EEDDC2;">
         <effect>
            <ColorAdjust saturation="-0.6" />
         </effect>
         <children>
            <Label layoutX="14.0" layoutY="14.0" minWidth="200.0" text="This page should provide clear guidance on how to navigate and utilize the key features of this e-Library as an Admin. " wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="40.0" />
            <Label layoutX="14.0" layoutY="14.0" text="Help Page" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label layoutX="14.0" layoutY="14.0" minWidth="200.0" text="Starting from the homepage the admin can browse through all the library's books. He can press the modify button next to a Book to navigate to its page and change its characteristics from there. He can also press the delete button to delete this book from the Library altogether." wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="95.0" />
            <Label layoutX="10.0" layoutY="174.0" text="Search Books : " wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="174.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="8.0" layoutY="271.0" text="Manage Books :" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="285.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="6.0" layoutY="76.0" text="Homepage :" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="80.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="10.0" layoutY="193.0" minWidth="400.0" text="Use the search bar at the top of the page to find books by title or you can navigate to the Advanced Book Search page by the side menu where you can perform book searches by author, title, publisher, or year of release, or even combine these criteria. The buttons modify and delete book can be found in the search result lists as well." wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="190.0" />
            <Label layoutX="10.0" layoutY="397.0" text="Manage Categories :" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="400.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="8.0" layoutY="479.0" text="Manage Borrows :" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="510.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="10.0" layoutY="586.0" text="Manage Users :" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="585.0">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label layoutX="10.0" layoutY="288.0" minWidth="399.0" text="In this page the admin can see all the books by category. In each of these lists there are buttons to modify and delete book as this was described above. In the Book page the admin can change the features of a book one by one. At the bottom of the Book's modify page a delete button is also found." wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="300.0" />
            <Label layoutX="10.0" layoutY="10.0" minWidth="400.0" text="This page contains all the existing categories of the library. The admin can delete a category and all the books it contains by pressing the delete category button next to the category's name. An admin can also change a category's name by enetring the new name in the test field below the current name and by pressing the button &quot;Change Category Name&quot;" wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="415.0" />
            <Label layoutX="10.0" layoutY="497.0" minWidth="400.0" text="In this page all the current active borrows can be found. The admin can terminate an active borrow by pressing the button Terminate at the right of the borrow's cell." wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="525.0" />
            <Label layoutX="14.0" layoutY="604.0" minHeight="100.0" minWidth="400.0" text="In this page the admin can see all the regular users of the library in a list. At each User cell of the list there is a Delete button, that deletes this user if it is clicked, and a Modify User Button that navigates the admin to the Modify User Page. The modify user page displays all the current User's information, which the admin can change one by one, and there is a Delete User button at the bottom of this page that can be also used to delete this user." wrapText="true" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="600.0" />
         </children>
      </AnchorPane>
   </content>
</ScrollPane>
