      <ListView id="listView_searchResult" fx:id="categoryList" blendMode="MULTIPLY" focusTraversable="false" layoutX="11.2" layoutY="106.4" prefHeight="227.0" prefWidth="431.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="11.0" AnchorPane.rightAnchor="11.0" AnchorPane.topAnchor="105.0">
