<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="vbox" minHeight="100.0" prefHeight="100.0" prefWidth="488.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox prefHeight="31.0" prefWidth="382.0">
         <VBox.margin>
            <Insets bottom="5.0" />
         </VBox.margin>
         <children>
            <Label fx:id="categoryName" prefHeight="30.0" prefWidth="337.0" text="category Name">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Button fx:id="deleteCategory_btn" minWidth="130.0" mnemonicParsing="false" onMouseClicked="#deleteCategory" onMouseEntered="#hoverActivatedDelete" onMouseExited="#hoverDeactivatedDelete" prefHeight="26.0" prefWidth="130.0" style="-fx-background-color: #E74C3C;" text="Delete Category">
               <HBox.margin>
                  <Insets left="10.0" right="10.0" top="5.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <TextField fx:id="newName_input" maxWidth="478.0" promptText="Enter new name for this category">
         <VBox.margin>
            <Insets bottom="5.0" right="10.0" />
         </VBox.margin>
      </TextField>
      <Button fx:id="changeName_btn" minWidth="150.0" mnemonicParsing="false" onMouseClicked="#changeCategoryName" onMouseEntered="#hoverActivated" onMouseExited="#hoverDeactivated" prefHeight="25.0" prefWidth="150.0" style="-fx-background-color: #B69E7A;" text="Change Category Name">
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </Button>
   </children>
</VBox>
